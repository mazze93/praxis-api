meta {
  name: Seed Policy (Admin)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/admin/policy/seed
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_api_key}}
}

body:json {
  {
    "version": 1,
    "policy_sets": [
      { "id": "daedalus_dev", "label": "Daedalus: Dev (fast, permissive)" },
      { "id": "daedalus_prod", "label": "Daedalus: Prod (strict)" },
      { "id": "securepride_client", "label": "Secure Pride: Client (paranoid)" }
    ],
    "identities": {
      "daedalus": {
        "label": "Daedalus Systems",
        "default_policy_set": "daedalus_prod"
      }
    },
    "triggers": {
      "research": { "label": "Research / summarization" },
      "ops": { "label": "Operations / coordination" },
      "write": { "label": "Writes / mutations" },
      "admin": { "label": "Privileged admin" }
    },
    "tiers": {
      "T0_DENY": {
        "description": "Never allowed",
        "allow": { "tool_names": [], "tool_patterns": [] },
        "quotas": { "max_calls_per_request": 0 },
        "redaction": { "mode": "block" }
      },
      "T1_READONLY": {
        "description": "Read-only tools",
        "allow": { "tool_patterns": ["^search_", "^get_", "^list_", "^ping$"] },
        "quotas": {
          "max_calls_per_request": 25,
          "max_calls_per_tool": 10,
          "max_response_bytes": 150000
        },
        "callers": {
          "allow_callers": [{ "type": "model" }],
          "require_signed_caller": false
        },
        "redaction": { "mode": "off" }
      }
    },
    "policy_matrix": {
      "daedalus_prod": {
        "daedalus": {
          "research": "T1_READONLY",
          "ops": "T1_READONLY",
          "write": "T0_DENY",
          "admin": "T0_DENY"
        }
      }
    },
    "tool_overrides": []
  }
}

assert {
  res.status: eq 200
  res.body.ok: eq true
}
